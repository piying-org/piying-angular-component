[
  {
    "name": "common-data",
    "description": "字符串或模板渲染组件，能够根据传入的内容自动判断类型并选择合适的渲染方式，支持字符串、数字、布尔值、TemplateRef模板、Schema对象以及包含image/icon/title的对象。",
    "type": "表单控件组件",
    "inputs": [
      {
        "name": "content",
        "type": "any",
        "description": "要渲染的内容，可以是字符串、TemplateRef、Schema对象或包含image/icon/title的对象"
      }
    ],
    "outputs": [],
    "props": []
  },
  {
    "name": "checkbox",
    "alias-list": ["boolean"],
    "description": "复选框控件，提供单个复选框的勾选功能，支持确定、不确定两种状态，常用于需要选择多个选项的场景。",
    "type": "表单控件组件",
    "inputs": [
      {
        "name": "color",
        "type": "Color",
        "description": "复选框的颜色主题"
      },
      {
        "name": "size",
        "type": "Size",
        "description": "复选框的尺寸"
      },
      {
        "name": "indeterminate",
        "type": "boolean",
        "description": "是否为不确定状态"
      }
    ],
    "outputs": [],
    "props": []
  },
  {
    "name": "input",
    "alias-list": ["string", "number", "date"],
    "description": "文本输入控件，提供多种类型的文本输入功能，支持文本、密码、数字、日期等常见输入场景，适合作为表单中的基础输入组件使用。",
    "type": "表单控件组件",
    "inputs": [
      {
        "name": "type",
        "type": "'text' | 'password' | 'email' | 'number' | 'date' | 'datetime-local' | 'week' | 'month' | 'tel' | 'url' | 'search' | 'time'",
        "description": "输入框的类型，默认为'text'"
      },
      {
        "name": "ghost",
        "type": "boolean",
        "description": "是否为幽灵样式"
      },
      {
        "name": "color",
        "type": "Color",
        "description": "输入框的颜色主题"
      },
      {
        "name": "size",
        "type": "Size",
        "description": "输入框的尺寸"
      }
    ],
    "outputs": [],
    "props": []
  },
  {
    "name": "select",
    "alias-list": ["picklist"],
    "description": "选择器控件，提供下拉选择功能，支持单选、多选以及原生select样式，适用于需要在多个选项中选择一个或多个的场景。",
    "type": "表单控件组件",
    "inputs": [
      {
        "name": "color",
        "type": "Color",
        "description": "选择器的颜色主题"
      },
      {
        "name": "size",
        "type": "Size",
        "description": "选择器的尺寸"
      },
      {
        "name": "multiple",
        "type": "boolean",
        "description": "是否支持多选"
      },
      {
        "name": "ghost",
        "type": "boolean",
        "description": "是否为幽灵样式"
      },
      {
        "name": "native",
        "type": "boolean",
        "description": "是否使用原生select样式"
      },
      {
        "name": "options",
        "type": "SelectOption[]",
        "description": "选项列表，用于配置可选择的选项"
      },
      {
        "name": "optionConvert",
        "type": "OptionConvert",
        "description": "选项转换器，用于自定义选项的label和value映射"
      },
      {
